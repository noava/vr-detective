  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshPro
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '<size=36>Statement</size>

    Serine Sanderson


    "There is a lot of weird people staying here at the motel."


    "I''ve seen everything. This is the fifth incident this month...sigh...I''m too old for this."


    "I don''t even get paid. I get free tickets to the GreenForest waterpark as compensation."


    "But back on track....He was a nice man I would say. Mr Niklaz was sadly spoken for, else I think we could have had it quite fun together."


    "I cleaned up this room a lot over the weeks he sayed. There''s the paintings, and the cigarettes, but everyone needs hobbies don''t they? I myself like to collect toenails. Would you like to see?"


'
  m_isRightToLeft: 0
