  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=36>Help</size>\nI think someone is out to get me. \nThe neighbours are mad at me and I don't know for how much longer they will stay polite about it.\n\nIf someone finds this message, that means I'm dead. \nFind out who did it. They have to have left some clues around the room. You just need to look.\n......\nAnd also, tell Serine Sanderson I would have left my wife for her. \n\n- Mr Niklas\n\n\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3537dae61a2df6f47a28f6fe9b80a6c9, type: 2}
  m_sharedMaterial: {fileID: -463386558564590148, guid: 3537dae61a2df6f47a28f6fe9b80a6c9, type: 2}
