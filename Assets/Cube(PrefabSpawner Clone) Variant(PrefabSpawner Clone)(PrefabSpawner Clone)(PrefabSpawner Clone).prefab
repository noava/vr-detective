  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=36>Witness</size>\nSerine Sanderson\n\nAge: 99\nheight: 1.52\n\n- Reitred bingo champion\n- Retired caretaker\n- Retired astronaut\n- Retired chef\n- She's just really tired \n\nPhoto:\n"
  m_isRightToLeft: 0
